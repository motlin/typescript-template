{
	"name": "@your-org/typescript-template",
	"version": "0.0.0",
	"description": "A standardized TypeScript project template",
	"type": "module",
	"scripts":
	{
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"build": "vp build",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "oxfmt-next-line",
		"fmt:ci": "oxfmt-next-line --check",
		"fallow": "fallow fix --yes --no-create-config",
		"fallow:ci": "fallow dead-code",
		"typecheck": "tsc --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && test-storybook\"",
		"prepare": "VITE_GIT_HOOKS=0 vp config"
	},
	"dependencies":
	{
		"agentation": "^3.1.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies":
	{
		"@chromatic-com/storybook": "^5.6.0",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-onboarding": "^10.6.5",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@storybook/test-runner": "^0.26.0",
		"@tanstack/react-query-devtools": "^5.105.3",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"eslint": "10.14.0",
		"eslint-plugin-storybook": "^10.6.5",
		"fallow": "^3.38.1",
		"jiti": "^2.7.0",
		"jsdom": "^30.1.3",
		"markdownlint-cli2": "^0.24.0",
		"playwright": "^1.64.1",
		"storybook": "^10.6.5",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.12.1"
}
